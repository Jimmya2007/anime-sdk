---
import LogoIcon from './icons/LogoIcon.astro';
import GitHubIcon from './icons/GitHubIcon.astro';
---

<nav
  style="border-bottom: 1px solid var(--border); background: var(--bg); position: sticky; top: 0; z-index: 50;"
>
  <div class="flex h-[50px] items-center justify-between px-10">
    <div class="flex items-center gap-8">
      <a href="#" class="flex items-center gap-2">
        <div class="flex h-[22px] w-[22px] items-center justify-center bg-violet-500">
          <LogoIcon size={10} />
        </div>
        <span class="text-[13.5px] font-semibold tracking-tight">ani-sdk</span>
      </a>
      <div class="hidden items-center gap-6 md:flex" style="color: var(--muted); font-size: 13px;">
        <a href="/docs/" class="transition-colors hover:text-white">Docs</a>
        <a href="#use-cases" class="transition-colors hover:text-white">Use Cases</a>
        <a href="#server" class="transition-colors hover:text-white">HTTP Server</a>
        <a href="#install" class="transition-colors hover:text-white">Install</a>
        <a href="/faq" class="transition-colors hover:text-white">FAQ</a>
      </div>
    </div>
    <div class="flex items-center gap-4">
      <a
        href="https://github.com/hexxt-git/ani-sdk"
        target="_blank"
        class="flex items-center gap-1.5 text-[13px] transition-colors hover:text-white"
        style="color: var(--muted);"
      >
        <GitHubIcon class="h-[15px] w-[15px]" />
        GitHub
      </a>
      <a
        href="#install"
        class="bg-white px-4 py-1.5 text-[12.5px] font-semibold text-black transition-colors hover:bg-zinc-100"
      >
        Get Started
      </a>
    </div>
  </div>
</nav>
