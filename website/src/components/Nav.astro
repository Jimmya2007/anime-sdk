---
import LogoIcon from './icons/LogoIcon.astro'
import GitHubIcon from './icons/GitHubIcon.astro'
---

<nav style="border-bottom: 1px solid var(--border); background: var(--bg); position: sticky; top: 0; z-index: 50;">
  <div class="frame" style="border-left: none; border-right: none;">
    <div
      class="max-w-[1100px] mx-auto px-10 h-[50px] flex items-center justify-between"
      style="border-left: 1px solid var(--border); border-right: 1px solid var(--border);"
    >
      <div class="flex items-center gap-8">
        <a href="#" class="flex items-center gap-2">
          <div class="w-[22px] h-[22px] bg-violet-500 flex items-center justify-center">
            <LogoIcon size={10} />
          </div>
          <span class="font-semibold text-[13.5px] tracking-tight">ani-sdk</span>
        </a>
        <div class="hidden md:flex items-center gap-6" style="color: var(--muted); font-size: 13px;">
          <a href="#providers" class="hover:text-white transition-colors">Providers</a>
          <a href="#use-cases" class="hover:text-white transition-colors">Use Cases</a>
          <a href="#server" class="hover:text-white transition-colors">HTTP Server</a>
          <a href="#install" class="hover:text-white transition-colors">Install</a>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <a
          href="https://github.com/hexxt-git/ani-sdk"
          target="_blank"
          class="flex items-center gap-1.5 text-[13px] hover:text-white transition-colors"
          style="color: var(--muted);"
        >
          <GitHubIcon class="w-[15px] h-[15px]" />
          GitHub
        </a>
        <a
          href="#install"
          class="text-[12.5px] font-semibold bg-white text-black px-4 py-1.5 hover:bg-zinc-100 transition-colors"
        >
          Get Started
        </a>
      </div>
    </div>
  </div>
</nav>
