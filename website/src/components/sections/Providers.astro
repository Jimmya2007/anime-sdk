---
---

<section id="providers">
  <div class="hline py-8 px-10">
    <h2 class="text-[28px] font-bold tracking-tight mb-1">Providers.</h2>
    <p class="text-[14px]" style="color: var(--muted);">
      Three live-tested sources. Each one verified by a real ffmpeg frame capture on every run.
    </p>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 hline">
    <div class="cell no-bottom">
      <div class="flex items-center justify-between mb-4">
        <span class="font-semibold text-[15px]">allmanga</span>
        <span class="badge badge-ok">sub · dub</span>
      </div>
      <p class="text-[12.5px] leading-relaxed mb-4" style="color: var(--muted);">
        Large English-language catalog with sub and dub, backed by the AllAnime GraphQL API.
      </p>
      <span class="text-[11px] font-mono" style="color: var(--muted);">allmanga.to</span>
    </div>

    <div class="cell no-bottom">
      <div class="flex items-center justify-between mb-4">
        <span class="font-semibold text-[15px]">gogoanime</span>
        <span class="badge badge-ok">sub</span>
      </div>
      <p class="text-[12.5px] leading-relaxed mb-4" style="color: var(--muted);">
        Subtitled anime via anineko.to. Resolves direct HLS manifests with proxy-aware chunk rewriting.
      </p>
      <span class="text-[11px] font-mono" style="color: var(--muted);">anineko.to</span>
    </div>

    <div class="cell no-right no-bottom">
      <div class="flex items-center justify-between mb-4">
        <span class="font-semibold text-[15px]">goyabu</span>
        <span class="badge badge-ok">pt-br</span>
      </div>
      <p class="text-[12.5px] leading-relaxed mb-4" style="color: var(--muted);">
        Portuguese-subtitled anime for Brazilian audiences, sourced via Google's batchexecute RPC.
      </p>
      <span class="text-[11px] font-mono" style="color: var(--muted);">goyabu.io</span>
    </div>
  </div>
</section>
