---
import LogoIcon from './icons/LogoIcon.astro';
import type { Props } from '@astrojs/starlight/props';
const { siteTitleHref, siteTitle } = Astro.props;
---

<a href={siteTitleHref} class="site-title">
  <div class="logo-box">
    <LogoIcon size={10} />
  </div>
  <span>{siteTitle}</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--sl-text-h4);
    font-weight: 600;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
  }

  .logo-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background-color: #7c3aed;
    flex-shrink: 0;
  }
</style>
