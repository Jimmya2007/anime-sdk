---
type IconType = 'mobile' | 'web' | 'desktop' | 'cli' | 'server';
interface Props {
  type: IconType;
}
const { type } = Astro.props;
---

{
  type === 'mobile' && (
    <svg width="42" height="42" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <rect x="5" y="2" width="14" height="20" rx="3" opacity="0.25" />
      <rect x="7" y="6" width="10" height="11" rx="1.5" />
      <rect x="10.5" y="19" width="3" height="1.5" rx="0.75" opacity="0.6" />
    </svg>
  )
}

{
  type === 'web' && (
    <svg width="42" height="42" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <circle cx="12" cy="12" r="10" opacity="0.25" />
      <path d="M12 2C15.3 5.5 15.3 18.5 12 22C8.7 18.5 8.7 5.5 12 2Z" />
      <rect x="2" y="10.5" width="20" height="3" rx="1.5" opacity="0.5" />
    </svg>
  )
}

{
  type === 'desktop' && (
    <svg width="42" height="42" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <rect x="1" y="3" width="22" height="15" rx="2.5" opacity="0.25" />
      <rect x="3" y="5" width="18" height="11" rx="1.5" />
      <rect x="8" y="19" width="8" height="2" rx="1" opacity="0.25" />
      <rect x="11" y="18" width="2" height="1.5" />
    </svg>
  )
}

{
  type === 'cli' && (
    <svg width="42" height="42" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <rect x="2" y="4" width="20" height="16" rx="2.5" opacity="0.25" />
      <path
        d="M7 9L11.5 12L7 15"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <rect x="13" y="14" width="5" height="2" rx="1" />
    </svg>
  )
}

{
  type === 'server' && (
    <svg width="42" height="42" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <rect x="2" y="13" width="20" height="7" rx="2" opacity="0.25" />
      <rect x="2" y="4" width="20" height="8" rx="2" />
      <circle cx="18.5" cy="8" r="1.5" opacity="0.35" />
      <circle cx="18.5" cy="8" r="0.75" />
    </svg>
  )
}
