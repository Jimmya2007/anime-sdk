---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const sections = [
  {
    heading: 'License',
    body: 'ani-sdk is released under the <a href="https://github.com/hexxt-git/ani-sdk/blob/master/LICENSE" target="_blank" class="underline underline-offset-2 transition-colors hover:text-white">MIT License</a>. You are free to use, copy, modify, merge, publish, distribute, sublicense, and sell copies of the software, provided the copyright notice and permission notice appear in all copies.',
  },
  {
    heading: 'No warranty',
    body: 'The software is provided "as is", without warranty of any kind, express or implied, including but not limited to warranties of merchantability, fitness for a particular purpose, and non-infringement. The authors are not liable for any claim, damage, or other liability arising from use of the software.',
  },
  {
    heading: 'Upstream site changes',
    body: 'ani-sdk resolves streams from third-party sites. Those sites change their APIs and page structure without notice. We make no guarantee that any provider will work at any given time. The live E2E test suite exists to surface breakage quickly, but there will always be a gap between a site changing and a fix landing.',
  },
  {
    heading: 'Acceptable use',
    body: 'ani-sdk is a developer tool. It does not bypass DRM, crack paywalls, or circumvent access controls. Using it to build a public redistribution service for copyrighted content is your legal responsibility, not ours. Personal tooling, home servers, and research use are different situations — consult your own legal counsel for your specific context and jurisdiction.',
  },
  {
    heading: 'Third-party terms',
    body: 'Each upstream site has its own terms of service. Using ani-sdk to access those sites does not exempt you from their terms. You are responsible for ensuring your use complies with whatever agreements those sites impose.',
  },
  {
    heading: 'Changes to these terms',
    body: 'We may update these terms at any time. Changes are recorded in the Git history of this repository. Continued use of the SDK after changes constitutes acceptance.',
  },
];
---

<Layout
  title="Terms of Use — ani-sdk"
  description="Terms of use for ani-sdk. MIT-licensed open-source software. Read before building with ani-sdk."
  ogImage="/og/terms.png"
>
  <div class="font-sans text-white">
    <div class="frame">
      <Nav />

      <div class="hline px-10 py-8">
        <div class="label mb-3">LEGAL</div>
        <h1 class="mb-2 text-[32px] font-bold tracking-tight">Terms of Use.</h1>
        <p class="text-[14px]" style="color: var(--muted);">
          ani-sdk is MIT-licensed open-source software. These terms cover acceptable use and
          liability limits.
        </p>
      </div>

      {
        sections.map((s) => (
          <div class="hline px-10 py-6">
            <div class="mb-2 text-[14px] font-semibold">{s.heading}</div>
            <p
              class="text-[13px] leading-relaxed"
              style="color: var(--muted); max-width: 680px;"
              set:html={s.body}
            />
          </div>
        ))
      }

      <Footer />
    </div>
  </div>
</Layout>
