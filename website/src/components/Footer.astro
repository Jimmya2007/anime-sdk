---
import LogoIcon from './icons/LogoIcon.astro';
---

<footer class="hline flex flex-wrap items-center justify-between gap-4 px-10 py-7">
  <div class="flex items-center gap-3">
    <div class="flex h-[20px] w-[20px] items-center justify-center bg-violet-500">
      <LogoIcon size={9} />
    </div>
    <span class="text-[13px] font-semibold">ani-sdk</span>
    <span class="text-[12px]" style="color: var(--muted);">— MIT</span>
  </div>
  <div class="flex items-center gap-6 text-[13px]" style="color: var(--muted);">
    <a
      href="https://github.com/hexxt-git/ani-sdk"
      target="_blank"
      class="transition-colors hover:text-white">GitHub</a
    >
    <a
      href="https://github.com/hexxt-git/ani-sdk/blob/master/README.md"
      target="_blank"
      class="transition-colors hover:text-white">README</a
    >
    <a
      href="https://github.com/hexxt-git/ani-sdk/blob/master/FLARESOLVERR.md"
      target="_blank"
      class="transition-colors hover:text-white">FlareSolverr</a
    >
    <a
      href="https://github.com/hexxt-git/ani-sdk/issues"
      target="_blank"
      class="transition-colors hover:text-white">Issues</a
    >
  </div>
</footer>
