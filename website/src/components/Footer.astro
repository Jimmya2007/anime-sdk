---
import LogoIcon from './icons/LogoIcon.astro'
---

<footer class="hline px-10 py-7 flex items-center justify-between flex-wrap gap-4">
  <div class="flex items-center gap-3">
    <div class="w-[20px] h-[20px] bg-violet-500 flex items-center justify-center">
      <LogoIcon size={9} />
    </div>
    <span class="font-semibold text-[13px]">ani-sdk</span>
    <span class="text-[12px]" style="color: var(--muted);">— MIT</span>
  </div>
  <div class="flex items-center gap-6 text-[13px]" style="color: var(--muted);">
    <a href="https://github.com/hexxt-git/ani-sdk" target="_blank" class="hover:text-white transition-colors">GitHub</a>
    <a href="https://github.com/hexxt-git/ani-sdk/blob/master/README.md" target="_blank" class="hover:text-white transition-colors">README</a>
    <a href="https://github.com/hexxt-git/ani-sdk/blob/master/FLARESOLVERR.md" target="_blank" class="hover:text-white transition-colors">FlareSolverr</a>
    <a href="https://github.com/hexxt-git/ani-sdk/issues" target="_blank" class="hover:text-white transition-colors">Issues</a>
  </div>
</footer>
