---
const installCode = `<code>npm install <span class="str">ani-sdk</span>
pnpm add <span class="str">ani-sdk</span>
yarn add <span class="str">ani-sdk</span>
bun add <span class="str">ani-sdk</span></code>`;

const dockerCode = `<code>docker run <span class="str">-d</span> <span class="str">--name</span>=flaresolverr \\
  <span class="str">-p</span> <span class="num">8191</span>:<span class="num">8191</span> \\
  <span class="str">--restart</span> unless-stopped \\
  ghcr.io/flaresolverr/flaresolverr:latest</code>`;
---

<section id="install">
  <div class="hline px-10 py-8">
    <h2 class="mb-1 text-[28px] font-bold tracking-tight">Up in thirty seconds.</h2>
    <p class="text-[14px]" style="color: var(--muted);">
      Node 20+ for native
      <code class="bg-white/[0.06] px-1.5 py-0.5 font-mono text-[11.5px]">fetch</code>
      and
      <code class="bg-white/[0.06] px-1.5 py-0.5 font-mono text-[11.5px]">crypto.subtle</code>.
      <code class="bg-white/[0.06] px-1.5 py-0.5 font-mono text-[11.5px]">ffmpeg</code>
      only needed to run the E2E suite.
    </p>
  </div>

  <div class="hline grid grid-cols-1 md:grid-cols-2">
    <div class="cell no-bottom px-10 py-9">
      <div class="label mb-5">Package manager</div>
      <pre class="font-mono text-[12px] leading-[1.8] text-zinc-300" set:html={installCode} />
    </div>

    <div class="cell no-right no-bottom px-10 py-9">
      <div class="label mb-5">FlareSolverr (optional)</div>
      <pre class="font-mono text-[12px] leading-[1.8] text-zinc-300" set:html={dockerCode} />
      <p class="mt-4 text-[12px]" style="color: var(--muted);">
        Optional transport for CF/DDoS-Guard-protected sites.
        <code class="bg-white/[0.06] px-1.5 py-0.5 font-mono text-[11.5px]">FlareSolverrClient</code
        >
        wraps
        <code class="bg-white/[0.06] px-1.5 py-0.5 font-mono text-[11.5px]">get</code>/<code
          class="bg-white/[0.06] px-1.5 py-0.5 font-mono text-[11.5px]">post</code
        >
        with cookie reuse; see
        <code class="bg-white/[0.06] px-1.5 py-0.5 font-mono text-[11.5px]">FLARESOLVERR.md</code>.
      </p>
    </div>
  </div>
</section>
