---
import type { Props } from '@astrojs/starlight/props';
const { siteTitleHref, siteTitle } = Astro.props;
---

<a href={siteTitleHref} class="site-title">
  <img src="/ani-sdk.svg" width="22" height="22" alt="ani-sdk logo" />
  <span>{siteTitle}</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--sl-text-h4);
    font-weight: 600;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
  }
</style>
