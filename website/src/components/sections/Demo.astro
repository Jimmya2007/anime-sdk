---
const gogoanimeCode = `<code><span class="kw">import</span> <span class="pun">{</span> <span class="typ">HttpClient</span><span class="pun">,</span> <span class="typ">GogoanimeProvider</span> <span class="pun">}</span> <span class="kw">from</span> <span class="str">'ani-sdk'</span><span class="pun">;</span>
<span class="kw">import</span> <span class="pun">{</span> <span class="typ">DOMParser</span> <span class="kw">as</span> <span class="typ">LinkeDomParser</span> <span class="pun">}</span> <span class="kw">from</span> <span class="str">'linkedom'</span><span class="pun">;</span>

<span class="kw">const</span> provider <span class="pun">=</span> <span class="kw">new</span> <span class="fn">GogoanimeProvider</span><span class="pun">(</span>
  <span class="kw">new</span> <span class="fn">HttpClient</span><span class="pun">({</span> timeoutMs<span class="pun">:</span> <span class="num">10_000</span> <span class="pun">})</span>
<span class="pun">);</span>

<span class="kw">const</span> shows  <span class="pun">=</span> <span class="kw">await</span> provider<span class="pun">.</span><span class="fn">search</span><span class="pun">(</span><span class="str">'One Piece'</span><span class="pun">);</span>
<span class="kw">const</span> eps    <span class="pun">=</span> <span class="kw">await</span> provider<span class="pun">.</span><span class="fn">fetchContentUnits</span><span class="pun">(</span>shows<span class="pun">[</span><span class="num">0</span><span class="pun">].</span>id<span class="pun">);</span>
<span class="kw">const</span> stream <span class="pun">=</span> <span class="kw">await</span> provider<span class="pun">.</span><span class="fn">resolveStream</span><span class="pun">(</span>eps<span class="pun">[</span><span class="num">0</span><span class="pun">].</span>id<span class="pun">);</span>

<span class="kw">for</span> <span class="pun">(</span><span class="kw">const</span> s <span class="kw">of</span> stream<span class="pun">.</span>streams<span class="pun">)</span> console<span class="pun">.</span><span class="fn">log</span><span class="pun">(</span>s<span class="pun">.</span>sourceUrl<span class="pun">);</span>
<span class="cm">// → https://vidcdn.in/hls/one-piece-episode-1/master.m3u8</span></code>`;
---

<section id="demo">
  <div class="hline py-8 px-10">
    <h2 class="text-[28px] font-bold tracking-tight mb-1">
      From search to stream in three calls.
    </h2>
    <p class="text-[14px]" style="color: var(--muted);">
      Every provider exposes{" "}
      <code class="text-[11.5px] bg-white/[0.06] px-1.5 py-0.5 font-mono"
        >search</code
      >
      {" → "}
      <code class="text-[11.5px] bg-white/[0.06] px-1.5 py-0.5 font-mono"
        >fetchContentUnits</code
      >
      {" → "}
      <code class="text-[11.5px] bg-white/[0.06] px-1.5 py-0.5 font-mono"
        >resolveStream</code
      >
      . Swap the provider, the three calls don't change.
    </p>
  </div>

  <div class="hline">
    <div class="cell no-right no-bottom show-dots px-10 py-9">
      <div class="flex items-center gap-3 mb-5">
        <span class="badge badge-ok">Provider · gogoanime</span>
        <span class="text-[11px] font-mono" style="color: var(--muted);"
          >example.ts</span
        >
      </div>
      <pre
        class="text-[12px] font-mono leading-[1.85] text-zinc-300"
        set:html={gogoanimeCode}
      />
      <p class="text-[12px] mt-5" style="color: var(--muted);">
        Want sub/dub? Pass{" "}
        <code class="text-[11.5px] bg-white/[0.06] px-1.5 py-0.5 font-mono"
          >'sub' | 'dub' | 'raw'</code
        >
        {" "}to{" "}
        <code class="text-[11.5px] bg-white/[0.06] px-1.5 py-0.5 font-mono"
          >resolveStream</code
        >
        . Need a different source? Swap the provider — same three calls.
      </p>
    </div>
  </div>
</section>
